# Edusys — template for team members.
# Copy this file to .env.local and fill in your own values.
#   PowerShell:  Copy-Item .env.example .env.local
# This file IS committed. .env.local is NOT.

# Free key from https://aistudio.google.com/apikey — get your own.
GEMINI_API_KEY=""

# Don't change these. gemini-2.0-flash and gemini-2.5-flash are retired
# and return 404 on newly created keys.
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_MODEL_FALLBACK="gemini-3.5-flash-lite"

DATABASE_URL=""

# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

INTERVIEW_QUESTION_COUNT="8"
NEXT_PUBLIC_WEBCAM_PREVIEW="true"
NEXT_PUBLIC_WEBCAM_RECORDING="false"

BLOB_READ_WRITE_TOKEN=""
